{
  "name": "dsh-aris",
  "version": "0.1.1-local.2",
  "private": true,
  "description": "ARIS 0.1.1 host runtime and 83 Research-only skills for DSH 0.1.7-rc.2.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "repository": { "type": "git", "url": "git+https://github.com/wanshuiyin/Auto-claude-code-research-in-sleep.git" },
  "exports": {
    ".": "./dsh/index.mjs",
    "./runtime": "./dsh/runtime.mjs",
    "./skills": "./dsh/skills.mjs",
    "./client": "./dsh/client.js",
    "./scope-limits": "./dsh/scope-limits.mjs",
    "./codex": "./dsh/codex.mjs",
    "./cordis.patch.yml": "./dsh/cordis.patch.yml",
    "./presets/research.patch.yml": "./presets/research.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["dsh", "skills", "tools", "templates", "mcp-servers", "presets", "LOCAL-CHANGES.md", "README.md", "README_CN.md", "LICENSE"],
  "scripts": { "test": "node --test tests/*.test.mjs" },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.7-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.1.7-rc.2"
  },
  "dsh": {
    "bundle": { "patch": ["./dsh/cordis.patch.yml", "./presets/research.patch.yml"] },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-connection"]
    }
  }
}
