@@ -0,0 +1,99 @@
+/** Artificial metadata only: no copied Session text or historical user data. */
+import { Context } from '@deepseek-ai/cordis'
+import { SESSION_FORMAT_VERSION, SessionId } from '@deepseek-ai/dsh-session'
+import { SessionFormatUnsupportedError } from '@deepseek-ai/dsh-session-persistence'
+import type { SessionFormatJsonObject } from '@deepseek-ai/dsh-session-format'
+import JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+import { mkdir, mkdtemp, readFile, readdir, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { basename, dirname, join } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import { generationLogPath, type JsonlCompression } from '../src/format.ts'
+import { compressZstdFrame } from '../src/zstd.ts'
+
+const roots: string[] = []
+const contexts: Context[] = []
+const id = SessionId('synthetic-legacy-metadata')
+const descriptor = {
+  version: 2, mode: 'continuable', provider: 'fork', label: 'synthetic child',
+  agentProvider: 'mock', agentModel: 'mock', persona: 'synthetic persona',
+  toolFilter: { allow: ['read'], deny: ['write'] },
+}
+const source = { kind: 'instruction-hint', plugin: 'anchored-tool-bootstrap' }
+const message = { id: 'synthetic-hint', role: 'user', content: [{ type: 'text', text: 'Synthetic hint.' }], source }
+
+afterEach(async () => {
+  try {
+    await Promise.all(contexts.splice(0).map(ctx => ctx.fiber.dispose()))
+  } finally {
+    await Promise.all(roots.splice(0).map(root => rm(root, { recursive: true, force: true })))
+  }
+})
+
+async function seed(compression: JsonlCompression, data: SessionFormatJsonObject = descriptor, hint: SessionFormatJsonObject = source) {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-synthetic-legacy-metadata-'))
+  roots.push(root)
+  const path = generationLogPath(root, undefined, id, 0, compression)
+  const header = { type: 'session', version: 0, id, createdAt: 1, delegationDepth: 0 }
+  const rows = [
+    { type: 'turn/start', data: { turn: 1 } },
+    { type: 'subagent/descriptor', data },
+    { type: 'step/start', data: { turn: 1, step: 1 } },
+    { type: 'user/message', surfaceOp: 'append', data: { ...message, source: hint } },
+    { type: 'step/end', data: { turn: 1, step: 1 } },
+    { type: 'turn/end', data: { turn: 1, reason: { kind: 'completed' } } },
+  ].map((row, seq) => ({ ...row, seq, time: seq + 2 }))
+  const headerLine = JSON.stringify(header) + '\n'
+  const body = rows.map(row => JSON.stringify(row)).join('\n') + '\n'
+  const bytes = compression === 'none' ? Buffer.from(headerLine + body) : Buffer.concat([
+    await compressZstdFrame(headerLine), await compressZstdFrame(body),
+  ])
+  await mkdir(dirname(path), { recursive: true })
+  await writeFile(path, bytes)
+  const ctx = new Context()
+  contexts.push(ctx)
+  await ctx.plugin(JsonlSessionPersistence, { root, compression })
+  return { root, path, bytes, ctx }
+}
+
+async function read(ctx: Context, access: 'read' | 'write') {
+  const handle = await ctx.sessionPersistence.open(id, access)
+  try {
+    return { header: handle.header, ...(await handle.read()) }
+  } finally {
+    await handle.close()
+  }
+}
+
+describe('historical metadata publication', () => {
+  it.each(['none', 'zstd'] as const)('preserves source bytes through read, publish and reopen (%s)', async (compression) => {
+    const { root, path, bytes, ctx } = await seed(compression)
+    const prepared = await read(ctx, 'read')
+    expect(prepared.header.version).toBe(SESSION_FORMAT_VERSION)
+    expect(prepared.events.find(event => event.type === 'subagent/descriptor')?.data).toEqual({ ...descriptor, version: 3 })
+    expect(prepared.events.find(event => event.type === 'subagent/descriptor')?.data).not.toHaveProperty('agentReasoningEffort')
+    expect(prepared.events.find(event => event.type === 'user/message')?.data).toEqual(message)
+    expect(await readFile(path)).toEqual(bytes)
+    expect(await readdir(dirname(path))).toEqual([basename(path)])
+    const published = await read(ctx, 'write')
+    expect(published.events).toEqual(prepared.events)
+    expect((await read(ctx, 'read')).events).toEqual(prepared.events)
+    expect(await readFile(path)).toEqual(bytes)
+    const target = generationLogPath(root, undefined, id, SESSION_FORMAT_VERSION, compression)
+    expect((await readdir(dirname(path))).filter(name => name !== 'session.lock').sort()).toEqual([basename(path), basename(target)].sort())
+  })
+
+  it.each([
+    { name: 'descriptor extra field', data: { ...descriptor, extra: true }, hint: source },
+    { name: 'unknown descriptor version', data: { ...descriptor, version: 4 }, hint: source },
+    { name: 'hint extra coordinate', data: descriptor, hint: { ...source, sourceEventSeq: 0 } },
+    { name: 'hint wrong plugin', data: descriptor, hint: { ...source, plugin: 'other-plugin' } },
+  ])('refuses $name without writing a successor', async ({ data, hint }) => {
+    const { path, bytes, ctx } = await seed('none', data, hint)
+    for (const access of ['read', 'write'] as const) {
+      await expect(read(ctx, access)).rejects.toBeInstanceOf(SessionFormatUnsupportedError)
+      expect(await readFile(path)).toEqual(bytes)
+      expect((await readdir(dirname(path))).filter(name => name !== 'session.lock')).toEqual([basename(path)])
+    }
+  })
+})
