diff --git a/packages/session/session-format-catalog/tests/legacy-metadata.spec.ts b/packages/session/session-format-catalog/tests/legacy-metadata.spec.ts
new file mode 100644
index 0000000..bcd18d1
--- /dev/null
+++ b/packages/session/session-format-catalog/tests/legacy-metadata.spec.ts
@@ -0,0 +1,107 @@
+import { describe, expect, it } from 'vitest'
+import { SESSION_FORMAT_VERSION } from '@deepseek-ai/dsh-session'
+import { SessionFormatUnsupportedMigrationError } from '@deepseek-ai/dsh-session-format'
+import type { SessionFormatJsonObject } from '@deepseek-ai/dsh-session-format'
+import { createSessionFormatCatalogWithChildren } from '../src/index.ts'
+
+const descriptor: SessionFormatJsonObject = {
+  version: 2, mode: 'continuable', provider: 'fork', label: 'synthetic child',
+  agentProvider: 'synthetic-provider', agentModel: 'synthetic-model', persona: 'synthetic persona',
+  toolFilter: { allow: ['read', 'glob'], deny: ['write'] },
+}
+const source = { kind: 'instruction-hint', plugin: 'anchored-tool-bootstrap' }
+const message = { id: 'synthetic-hint', role: 'user', content: [{ type: 'text', text: 'Synthetic hint.' }], source }
+
+function rows(data: SessionFormatJsonObject, hint: SessionFormatJsonObject = source) {
+  return [
+    { type: 'turn/start', data: { turn: 1 } },
+    { type: 'subagent/descriptor', data },
+    { type: 'step/start', data: { turn: 1, step: 1 } },
+    { type: 'user/message', data: { ...message, source: hint }, surfaceOp: 'append' },
+    { type: 'step/end', data: { turn: 1, step: 1 } },
+    { type: 'turn/end', data: { turn: 1, reason: { kind: 'completed' } } },
+  ].map((row, seq) => ({ ...row, seq, time: seq + 2 }))
+}
+
+function restore(version: number, input: readonly unknown[], validation: 'current' | 'transformed' = 'current') {
+  const reader = createSessionFormatCatalogWithChildren([]).createRestore({
+    type: 'session', version, id: 'synthetic-legacy-metadata', createdAt: 1, delegationDepth: 0,
+    ...(version >= 2 ? { isSeeded: false } : {}),
+  }, { recovery: 'strict', validation })
+  for (const row of input) reader.decodeRow(row)
+  return reader.finish()
+}
+
+function freeze<T>(value: T): T {
+  if (value !== null && typeof value === 'object') {
+    Object.values(value).forEach(freeze)
+    Object.freeze(value)
+  }
+  return value
+}
+
+describe('exact released metadata through the current catalog', () => {
+  it.each(['current', 'transformed'] as const)('promotes descriptor v2 without changing composition (%s)', (validation) => {
+    const input = freeze(rows(descriptor))
+    const before = JSON.stringify(input)
+    const output = restore(0, input, validation)
+    expect(output.header.version).toBe(SESSION_FORMAT_VERSION)
+    expect(output.events.find(event => event.type === 'subagent/descriptor')).toEqual({
+      ...input[1], data: { ...descriptor, version: 3 },
+    })
+    expect(output.events.find(event => event.type === 'subagent/descriptor')?.data).not.toHaveProperty('agentReasoningEffort')
+    expect(output.events.find(event => event.type === 'user/message')?.data).toEqual(message)
+    expect(output).toEqual(restore(0, rows({ ...descriptor, version: 3 }), validation))
+    expect(JSON.stringify(input)).toBe(before)
+  })
+
+  it.each([
+    { version: 2, mode: 'one-shot', provider: 'spawn' },
+    { version: 2, mode: 'one-shot', provider: 'spawn', label: '' },
+    { version: 2, mode: 'continuable', provider: 'spawn', label: 'minimal child' },
+  ])('retains optional-field absence for descriptor %j', (data) => {
+    const output = restore(0, rows(data))
+    expect(output.events.find(event => event.type === 'subagent/descriptor')?.data).toEqual({ ...data, version: 3 })
+  })
+
+  it.each([0, 1, 2])('preserves the exact hint attribution from format v%i', (version) => {
+    const input = freeze(rows({ ...descriptor, version: 3 }))
+    const output = restore(version, input)
+    expect(output.events.filter(event => event.type === 'user/message')).toHaveLength(1)
+    expect(output.events.find(event => event.type === 'user/message')?.data).toEqual(message)
+    const reopened = restore(SESSION_FORMAT_VERSION, output.events)
+    expect(reopened).toEqual(output)
+  })
+
+  it.each([
+    { ...descriptor, extra: true },
+    { ...descriptor, agentReasoningEffort: 'high' },
+    { ...descriptor, toolFilter: { allow: ['read'], extra: true } },
+    { ...descriptor, mode: 'one-shot' },
+    { ...descriptor, mode: 'unknown' },
+    { ...descriptor, provider: '' },
+    { ...descriptor, label: '' },
+    { ...descriptor, agentModel: null },
+    { ...descriptor, toolFilter: { allow: [''] } },
+    ...[0, 1, 4, 99, '2'].map(version => ({ ...descriptor, version })),
+  ])('refuses unaudited or invalid descriptor metadata %j', (data) => {
+    expect(() => restore(0, rows(data))).toThrow(SessionFormatUnsupportedMigrationError)
+  })
+
+  it('does not invent a missing provider/model partner', () => {
+    const { agentModel: _model, ...unpaired } = descriptor
+    expect(() => restore(0, rows(unpaired))).toThrow(/must be paired/)
+  })
+
+  it.each([
+    { ...source, extra: true },
+    { ...source, sourceEventSeq: 0 },
+    { ...source, plugin: 'other-plugin' },
+    { kind: 'instruction-hint' },
+    { ...source, kind: 'other-source' },
+  ])('refuses unknown source constants or fields %j', (hint) => {
+    for (const version of [0, 1, 2]) {
+      expect(() => restore(version, rows({ ...descriptor, version: 3 }, hint))).toThrow(SessionFormatUnsupportedMigrationError)
+    }
+  })
+})
