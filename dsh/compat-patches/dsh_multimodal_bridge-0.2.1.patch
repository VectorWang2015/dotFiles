+// Tests must exercise the target checkout, never silently fall back to production.
+import { readFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
+export const checkout = resolve(process.env.DSH_CHECKOUT ?? '/home/vectorwang/Workspace/deepseek-harness-0.2.1-rc.2');
+const version = JSON.parse(readFileSync(resolve(checkout, 'package.json'), 'utf8')).version;
+if (version !== '0.2.1-rc.2') throw new Error(`Expected target DSH 0.2.1-rc.2, got ${version}`);
+export const target = relative => import(pathToFileURL(resolve(checkout, relative)).href);
