+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { Readable } from 'node:stream';
+import { apply, inject } from '../lib/index.js';
+function fixture(reject) {
+  const routes = new Map(); let disposed = false; let cleanup;
+  apply({ connection: { requestRejection: reject }, webServer: { register(row) { routes.set(row.path,row); return () => { disposed=true;routes.delete(row.path); }; } }, effect(fn) { cleanup=fn(); } });
+  return { routes, dispose(){cleanup();return disposed;} };
+}
+function response(){return {status:null,body:null,writeHead(s){this.status=s;},end(b){this.body=b;}};}
+function request(method, chunks=[]){const r=Readable.from(chunks);r.method=method;r.socket={remoteAddress:'127.0.0.1'};r.headers={};return r;}
+test('host waits for authentication owner and refuses unauthenticated routes before network/body work',async()=>{
+ assert.deepEqual(inject,['webServer','connection']);const f=fixture(()=>401);
+ for(const path of ['/api/copilot-board/overview','/api/copilot-board/error']){const res=response();await f.routes.get(path).handler(request(path.endsWith('overview')?'GET':'POST'),res);assert.equal(res.status,401);}
+ assert.equal(f.dispose(),true);assert.equal(f.routes.size,0);
+});
+test('routes retain loopback restriction and require their exact methods',async()=>{
+ const f=fixture(()=>undefined);
+ for(const [path,method] of [['/api/copilot-board/overview','POST'],['/api/copilot-board/error','GET']]){const res=response();await f.routes.get(path).handler(request(method),res);assert.equal(res.status,405);}
+ const remote=request('GET');remote.socket.remoteAddress='203.0.113.5';const res=response();await f.routes.get('/api/copilot-board/overview').handler(remote,res);assert.equal(res.status,403);f.dispose();
+});
+test('diagnostic body is bounded before accumulating the oversized chunk',async()=>{
+ const f=fixture(()=>undefined),res=response();await f.routes.get('/api/copilot-board/error').handler(request('POST',[Buffer.alloc(16385)]),res);assert.equal(res.status,413);f.dispose();
+});
